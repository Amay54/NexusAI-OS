# NexusAI OS Configuration Template

APP_NAME=NexusAI OS
APP_ENV=development
SECRET_KEY=nexusai-super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./nexusai.db
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=nexuspass
POSTGRES_DB=nexusaidb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Multi-LLM Providers (FREE ONLY)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_free_gemini_api_key
OLLAMA_BASE_URL=http://localhost:11434
DEEPSEEK_API_KEY=your_free_deepseek_api_key
QWEN_API_KEY=your_free_qwen_api_key

# MCP & Security Checkpoints
ENABLE_HITL_APPROVAL=true
